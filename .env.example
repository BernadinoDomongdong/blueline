# =============================================================================
# Blueline — environment configuration
# =============================================================================
# Copy this file to `.env` for local development (`vercel dev` reads it
# automatically), then set the same variables in Vercel → Settings →
# Environment Variables for your actual deployment.
#
# SECURITY:
#   - `.env` is gitignored — never commit it.
#   - This file (`.env.example`) IS meant to be committed/shared — never
#     paste a real key into it. Leave values blank, as below.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LLM PROVIDER — choose exactly one
# -----------------------------------------------------------------------------
# REQUIRED. One of: "openrouter" (default) | "custom" | "anthropic"
#
#   openrouter   One key, hundreds of models — Claude, GPT, Gemini, and a
#                rotating set of free community-hosted models.
#   custom       A model you run yourself (Ollama, LM Studio, vLLM), or your
#                org's own OpenAI-compatible LLM gateway.
#   anthropic    Calls the Anthropic Messages API directly — no middleman.
#
# Only the section below matching your choice is actually read at runtime —
# you don't need to fill in the other two.
LLM_PROVIDER=openrouter


# -----------------------------------------------------------------------------
# 2a. Provider: openrouter
# -----------------------------------------------------------------------------
# Read only when LLM_PROVIDER=openrouter.

# REQUIRED. Get a free key (no card needed) at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# REQUIRED. Paste ONE model id below — no code changes needed either way.
# This shortlist is a snapshot of https://openrouter.ai/api/v1/models from
# July 2026, chosen for what this app actually does (turning SQL/DAX/Power
# Query into strict-schema lineage JSON): strong coding/structured-output
# benchmarks, generous context windows. Any other id from
# openrouter.ai/models also works — this is a starting shortlist, not an
# allowlist. OpenRouter's free roster rotates often; if an id below 404s,
# check openrouter.ai/models?q=free for its replacement.
#
#   FREE — $0, rate-limited by OpenRouter (20 req/min; 50/day with no
#   credits purchased, 1,000/day once you've bought $10 in credits). Good
#   for trying Blueline out or light personal use, not production traffic.
#
#     poolside/laguna-m.1:free                 Best free pick — a coding-agent model, good at
#                                               turning SQL/DAX into structured JSON. 256K context.
#     tencent/hy3:free                         Large (295B) general reasoning model, solid fallback.
#     nvidia/nemotron-3-ultra-550b-a55b:free   Frontier-scale reasoning, 1M context — for very
#                                               large source-query sets.
#     poolside/laguna-xs-2.1:free              Smaller/faster coding model if you hit the rate
#                                               limit on the one above.
#
#   PAID — billed per-token by OpenRouter, no separate Anthropic/OpenAI/
#   Google account needed; far more reliable at structured-JSON extraction
#   than the free tier.
#
#     anthropic/claude-sonnet-5     Recommended default — the model this app's prompts were
#                                   originally written for. Strong, well-priced.
#     anthropic/claude-opus-4.8     Anthropic's most capable — worth it for large/messy source sets.
#     openai/gpt-5.6-sol            OpenAI's flagship — strong coding/reasoning, 1M context.
#     google/gemini-3.5-flash       Near-flagship coding quality for a fraction of the cost, 1M context.
#     z-ai/glm-5.2                  Cheapest of this list with a 1M context window.
OPENROUTER_MODEL=poolside/laguna-m.1:free

# OPTIONAL. Attribution only, for OpenRouter's own leaderboard/analytics —
# doesn't affect billing or model behavior.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Blueline

# OPTIONAL. Blueline's UI has an in-app model picker (a Free/Paid toggle
# + dropdown, populated from the FREE_MODELS/PAID_MODELS shortlist in
# lib/llmClient.js) so a visitor can choose a model per-request instead
# of always using OPENROUTER_MODEL above. Defaults to true. If you're
# deploying this publicly and want to keep costs predictable, set this
# to false to restrict the picker to free models only — paid models
# stay OPENROUTER_MODEL's fixed default and can't be selected in the UI.
ALLOW_PAID_MODELS=true


# -----------------------------------------------------------------------------
# 2b. Provider: custom (a local model, or your org's own model)
# -----------------------------------------------------------------------------
# Read only when LLM_PROVIDER=custom. Any OpenAI-compatible
# /chat/completions endpoint — Ollama, LM Studio, vLLM, an internal gateway.

# REQUIRED.
#   Ollama example:    http://localhost:11434/v1
#   LM Studio example: http://localhost:1234/v1
CUSTOM_LLM_BASE_URL=

# REQUIRED. The model name your endpoint expects — e.g. "llama3.1" for
# Ollama, or whatever your org's gateway calls its deployed model.
CUSTOM_LLM_MODEL=

# OPTIONAL. Most local servers ignore this or accept any non-empty string;
# org gateways usually require a real key. Leave blank for most local setups.
CUSTOM_LLM_API_KEY=


# -----------------------------------------------------------------------------
# 2c. Provider: anthropic (direct, no middleman)
# -----------------------------------------------------------------------------
# Read only when LLM_PROVIDER=anthropic.

# REQUIRED. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OPTIONAL. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5


# -----------------------------------------------------------------------------
# 3. Security & abuse protection — optional, recommended for production
# -----------------------------------------------------------------------------

# OPTIONAL. Restricts /api/* to requests whose Origin header matches your
# deployed URL. Left unset, this check is skipped — fine for local dev.
#   Example: https://blueline.yourdomain.com
ALLOWED_ORIGIN=

# OPTIONAL. The shared, all-visitors request budget per minute across
# /api/infer-lineage, /api/ask, and /api/report combined. Defaults to 60
# if unset. See README → "Security, in brief" for why this exists.
GLOBAL_RATE_LIMIT_PER_MINUTE=60
